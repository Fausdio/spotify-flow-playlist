# --- Credenciais do Spotify (obrigatórias) ---
# Crie um app gratuito em https://developer.spotify.com/dashboard
# Redirect URI cadastrada no app deve ser IGUAL a esta:
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# --- GetSongBPM (opcional, fallback de BPM/tom) ---
# Só é usado se o endpoint audio-features da própria Spotify estiver bloqueado
# para o seu app (comum em apps criados após nov/2024) e você passar --use-getsongbpm.
# Registre-se de graça em https://getsongbpm.com/api
GETSONGBPM_API_KEY=
